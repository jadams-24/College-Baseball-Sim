   "unofficial_visit_with_athletics_open": "Sep 1 of the junior year (13.7.1.2)",
   "official_visits_per_school": "one before Oct 15 after high school, one after; one more after a head-coach change (13.6.2.2, 13.6.2.2.1)",
   "written_offer_open": "Aug 1 of the senior year (13.9.3.1)",
   "signing_date": "second Wednesday (7 a.m.) in November (13.02.13.1(f)): 2026-11-11; undergraduate transfers from the first day (7 a.m.) of their notification-of-transfer period, postgraduates from Oct 1 (13.02.13.2)",
   "signed_prospect_contact_ban_releases": "aid reduced or cancelled; academically ineligible; not enrolled full time; release requested within 30 days of the head coach's departure; a granted release (two business days to answer, default grant) (13.1.1.2.1)",
   "roster_limit": "34 (17.2, effective 7/1/25); roster due the day before the first contest counted for selection or Dec 1, whichever is earlier (17.2.1)",
   "portal_windows": "Dec 1-15; a 30-consecutive-day period beginning seven days after championship selections (13.1.1.4.1(h)); 2026-27: Dec 1-15, 2026 and Jun 7 - Jul 6, 2027",
   "portal_exceptions": "head coach departs or announces departure: 30 consecutive days (13.1.1.4.1.1.1(a)); postgraduates may use the undergraduate exceptions (13.1.1.4.2.1)",
   "eligibility_clock": "12.6: five academic years from the earlier of the first full-time term attended or the academic year after the 19th birthday; revised 6/24/26 (effective 8/1/26) and 9/9/26: 12.6.1 a 19th birthday on Sep 1 - Dec 31 starts the clock the following fall; 12.6.2 first enrollment May 1 - Nov 1 starts the clock that fall, Nov 1 - May 1 the next regular term; 12.6.3 a clock ending with a fall term runs to the day before the spring term, and a championship that begins inside the period extends it to the team's last game; 12.6.10 no waivers",
   "incremental_scholarship_cap": "$2.5M of aid above the 2024-25 sport limits counts against the cap (16.13.1.5)"
  },
  "changes_since_spec": [
   "12.6.1-12.6.3 adopted 9/9/26 (clock start and end details); no baseball recruiting date changed; the women's flag football roster limit was the only 17.2 revision (8/25/26)"
  ]
